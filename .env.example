# OLX partner API application (developer.olx.bg)
client_id=
client_secret=
# Optional: OAuth redirect URI registered in the OLX app, e.g. https://<machine>.<tailnet>.ts.net/olx/callback
# redirect_uri=

# OpenRouter (openrouter.ai/keys): used for the vision, research and agent stages
OPENROUTER_API_KEY=
# VISION_MODEL=google/gemini-3.5-flash-lite
# RESEARCH_MODEL=google/gemini-3.5-flash-lite
# AGENT_MODEL=anthropic/claude-sonnet-5.5
# AGENT_MAX_ITERATIONS=15
# AGENT_MAX_COST=0.50   (USD per agent run)
# SHOW_TRACE=true

# Optional overrides
# DATA_DIR=./data
# SESSION_SECRET=   (auto-generated into data/.session_secret if unset)

# S3 bucket for listing photos at submit time; filled in by infra/s3-setup.sh
# S3_BUCKET=
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
